{
  "name": "qaautomationchallenge",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI automation suite for the DemoBlaze demo shop",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myatthin12/QAAutomationChallenge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/myatthin12/QAAutomationChallenge/issues"
  },
  "homepage": "https://github.com/myatthin12/QAAutomationChallenge#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4"
  },
  "dependencies": {
    "dotenv": "^18.0.5"
  }
}

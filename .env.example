# Copy this file to .env before running the suite:
#   cp .env.example .env

# --- Targets ---------------------------------------------------------------
BASE_URL=https://www.demoblaze.com
API_BASE_URL=https://api.demoblaze.com

# --- Credentials -----------------------------------------------------------
# Pre-registered DemoBlaze account used by the login specs. Cart and checkout
# specs register a throwaway account per test instead - see README section 10.
DEMOBLAZE_USERNAME=ChallengeUser
DEMOBLAZE_PASSWORD=ChallengeUser

# --- Performance budgets (milliseconds) ------------------------------------
# Generous regression tripwires, not SLAs: the target is a shared demo host.
PERF_HOME_LOAD_MS=10000
PERF_FCP_MS=6000
PERF_DCL_MS=8000
PERF_API_MS=3000

# --- Local workarounds -----------------------------------------------------
# Set to 1 if a stale OS-level proxy makes local Firefox runs fail with
# NS_ERROR_PROXY_CONNECTION_REFUSED. Leave unset on CI.
# IGNORE_SYSTEM_PROXY=1
